# At least 32 random bytes (PyJWT warns below that for HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
OD_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
OD_DATABASE=data/od.db

# Where issued-token metadata lives (tools/generate_token.py,
# tools/revoke_token.py, tools/list_tokens.py) — not scraped data, so
# it is outside data/ on purpose and survives supervisor.py's daily wipe.
OD_TOKENS_DATABASE=tokens.db
